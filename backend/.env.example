NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8081
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oco_local
# Postgres password consumed by docker-compose (db service + DATABASE_URL interpolation).
# Required by the compose stack; keep it consistent with DATABASE_URL above.
POSTGRES_PASSWORD=change-this-to-a-strong-password
# Must be at least 32 chars and NOT this placeholder. Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-32-plus-char-secret-do-not-use-this-value
COOKIE_DOMAIN=localhost
MEDIA_BASE_URL=http://localhost:4000/uploads
# Comma-separated list of allowed browser origins for CORS (leave blank to use defaults).
CORS_ALLOWED_ORIGINS=
GA4_MEASUREMENT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Required: do not keep defaults in real environments
DEFAULT_ADMIN_EMAIL=admin@your-domain.com
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-password
PRIVATE_PAGE_DEFAULT_USERNAME=partner-access-user
PRIVATE_PAGE_DEFAULT_PASSWORD=change-this-to-a-strong-password
CMS_QUERY_TIMEOUT_MS=600
CMS_CIRCUIT_BREAKER_MS=30000
CMS_RENDERING_ENABLED=true
